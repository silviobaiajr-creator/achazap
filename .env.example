# ============================================================
# AchaZap — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais
# NUNCA commite o arquivo .env no Git
# ============================================================

# --- Supabase ---
SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# --- WhatsApp Business API (Meta) ---
WHATSAPP_VERIFY_TOKEN=um_token_secreto_que_voce_inventa
WHATSAPP_ACCESS_TOKEN=EAAxxxxx...
WHATSAPP_PHONE_NUMBER_ID=1234567890
WHATSAPP_APP_SECRET=xxxxxxxxxxxxxxxx   # Segredo do App (valida assinatura HMAC)

# --- Google Gemini ---
GEMINI_API_KEY=AIzaSy...

# --- Redis (BullMQ) ---
# Use Redis local em dev: redis://localhost:6379
# Em produção: use Upstash Redis (gratuito, sem server)
REDIS_URL=redis://localhost:6379

# --- Servidor ---
PORT=3000
NODE_ENV=development
BASE_URL=https://achazap.com   # URL base para links /r?token= (sem barra final)
